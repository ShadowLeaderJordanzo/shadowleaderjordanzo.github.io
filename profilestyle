@media only screen and (max-width: 845px) {
    .lead {
        font-size:0.75rem;
    }
    .navbar ul li {
        margin: 0 0.2rem;
        padding: 0.2rem;
    }
    .navbar ul li a {
        margin: 0 0.2rem;
        padding: 0.2rem;
    }
}
@media only screen and (max-width: 640px) {
    .lead {
        font-size:0.7rem;
    }
}
@media only screen and (max-width: 500px) {
    .lead {
        font-size:0.70rem;
        padding: 0.4rem;
        font-family: 'Times New Roman', Times, serif;
    }
}
